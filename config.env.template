ANTHROPIC_API_KEY=your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6
# INTERVIEW_PREP_MODEL=claude-haiku-4-5-20251001  # cheaper model for interview prep (default: same as ANTHROPIC_MODEL)
# CV_TAILORING_MODEL=claude-haiku-4-5-20251001  # default; cheaper than main model
# Optional: max request body size in bytes (default 1000000 = 1MB)
# MAX_CONTENT_LENGTH=1000000
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here
INVITE_TOKEN=your-invite-token-here
PORT=5000
# Interface to bind (default 127.0.0.1; use 0.0.0.0 only if no reverse proxy is in front)
# BIND_HOST=127.0.0.1
# Number of reverse proxies (e.g. Caddy) in front of the app, so rate limits see the real client IP
# PROXY_HOPS=1
FLASK_DEBUG=0
